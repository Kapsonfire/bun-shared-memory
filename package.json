{
  "name": "bun-shared-memory",
  "version": "1.1.0",
  "description": "Share data between workers/threads using SharedArrayBuffer (zero-copy, 4-buffer architecture, Atomics-based synchronization).",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/esm/index.js",
  "module": "./dist/bundle.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/bundle.d.ts",
        "default": "./dist/bundle.js"
      },
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist/",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "typecheck": "bun check",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-reporter=text",
    "bench": "bun bench/bench.ts",
    "bench:real": "bun bench/real-world/run.ts",
    "bench:real:seed": "bun bench/real-world/seed.ts",
    "bench:real:mysql": "docker compose -f bench/real-world/docker-compose.yml up -d",
    "bench:contention": "bun bench/contention.ts",
    "bench:readscale": "bun bench/readscale.ts",
    "bench:real:sockets": "docker compose -f bench/real-world/docker-compose.yml -f bench/real-world/docker-compose.sockets.yml up -d"
  },
  "keywords": [
    "bun",
    "shared-memory",
    "sharedarraybuffer",
    "worker",
    "threads",
    "atomics",
    "zero-copy"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kapsonfire/bun-shared-memory.git"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "elysia": "^1.4.30",
    "typescript": "latest"
  }
}
